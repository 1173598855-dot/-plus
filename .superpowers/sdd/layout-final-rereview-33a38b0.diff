+:root {
+  --surface-base: #f3f5f4;
+  --surface-panel: #fbfcfa;
+  --surface-raised: #ffffff;
+  --surface-subtle: #edf1ef;
+  --ink: #18201d;
+  --muted: #59645f;
+  --muted-soft: #6b756f;
+  --line: #d7dedb;
+  --line-strong: #bec9c4;
+  --accent: #155e63;
+  --accent-soft: #deeeee;
+  --support: #526a88;
+  --support-soft: #e8edf3;
+  --danger: #a33a32;
+  --danger-soft: #f5e3e0;
+  --warning: #b54a2f;
+  --warning-soft: #fff8f6;
+  --radius-sm: 6px;
+  --radius-md: 8px;
+  --space-1: 4px;
+  --space-2: 8px;
+  --space-3: 12px;
+  --space-4: 16px;
+  --space-5: 20px;
+  --space-6: 24px;
+  color: var(--ink);
+  background: var(--surface-base);
+  font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  font-synthesis: none;
+  text-rendering: optimizeLegibility;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  min-width: 320px;
+  overflow-x: hidden;
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+}
+
+button {
+  cursor: pointer;
+}
+
+.workspace {
+  display: grid;
+  grid-template-columns: 280px minmax(0, 1fr);
+  min-height: 100dvh;
+  background: var(--surface-base);
+}
+
+.rail {
+  position: sticky;
+  top: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  max-height: 100dvh;
+  overflow-y: auto;
+  padding: 18px;
+  border-right: 1px solid var(--line);
+  background: var(--surface-panel);
+}
+
+.brand-block {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+}
+
+.brand-mark {
+  display: grid;
+  width: 42px;
+  min-width: 42px;
+  height: 42px;
+  place-items: center;
+  border: 2px solid var(--accent);
+  border-radius: var(--radius-md);
+  color: var(--accent);
+  font-weight: 800;
+}
+
+h1,
+h2,
+h3,
+p {
+  margin: 0;
+}
+
+h1 {
+  font-size: 19px;
+  line-height: 1.2;
+  text-wrap: balance;
+}
+
+h2,
+h3 {
+  text-wrap: balance;
+}
+
+.brand-block p,
+.task-card p,
+.message {
+  color: var(--muted);
+  font-size: 13px;
+}
+
+.metric-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 6px;
+}
+
+.metric-grid div,
+.quick-add,
+.detail,
+.column {
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  background: var(--surface-panel);
+}
+
+.metric-grid div {
+  min-width: 0;
+  padding: 8px 4px;
+  text-align: center;
+}
+
+.metric-grid strong {
+  display: block;
+  color: var(--warning);
+  font-family: ui-monospace, "Cascadia Mono", "Segoe UI Mono", monospace;
+  font-size: 20px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+}
+
+.metric-grid span {
+  display: block;
+  margin-top: 5px;
+  color: var(--muted);
+  font-size: 11px;
+  line-height: 1.2;
+}
+
+.quick-add {
+  display: grid;
+  gap: var(--space-2);
+  padding: var(--space-3);
+}
+
+.quick-capture-row {
