+  background: var(--surface-subtle);
+  opacity: 1;
+}
+
+.main-panel {
+  min-width: 0;
+  padding: 18px 20px 24px;
+}
+
+.toolbar {
+  display: grid;
+  gap: 8px;
+  margin-bottom: 8px;
+}
+
+.workband-primary {
+  display: grid;
+  grid-template-columns: auto minmax(240px, 1fr) minmax(220px, 320px) 40px;
+  align-items: stretch;
+}
+
+.search-box,
+.workspace-status,
+.filter-strip,
+.view-switch {
+  border: 1px solid var(--line);
