+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  border-radius: 7px;
+  transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 120ms ease;
+}
+
+.primary {
+  min-height: 42px;
+  border: 1px solid var(--accent);
+  color: #ffffff;
+  background: var(--accent);
+  font-weight: 700;
+}
+
+.primary:hover {
